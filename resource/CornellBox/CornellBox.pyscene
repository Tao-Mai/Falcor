from falcor import *

sceneBuilder.importScene("CornellBox.glb")

# 将光轴对准模型开口的中心，沿箱体深度方向水平取景。
camera = Camera("Cornell Box Camera")
camera.position = float3(-277.2, 274.4, 1000.0)
camera.target = float3(-277.2, 274.4, -279.6)
camera.up = float3(0.0, 1.0, 0.0)
# 方形画幅的四边落在开口内，填满渲染区。
camera.focalLength = 44.0
camera.nearPlane = 1.0
camera.farPlane = 5000.0
sceneBuilder.addCamera(camera)
sceneBuilder.selectedCamera = camera
sceneBuilder.cameraSpeed = 100.0

# Preserve the glTF area's emission strength in the Falcor material.
light = sceneBuilder.getMaterial("Emitter_Light_temp")
light.emissiveColor = float3(1.0, 1.0, 1.0)
light.emissiveFactor = 100.0
